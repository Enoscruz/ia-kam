# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODO=api
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Caminhos (opcional — padrão relativo à raiz do projeto)
PASTA_DADOS=dados
PASTA_LOGS=logs
PASTA_PROMPTS=app/prompts

# Gemini: mock (offline) ou vertex (Vertex AI)
# Se omitido, usa mock quando GOOGLE_CLOUD_PROJECT estiver vazio
# Com LLM_PROVIDER=openai, GEMINI_MODO é ignorado.
GEMINI_MODO=mock

# Logging
NIVEL_LOG=INFO

# Fonte de dados: azure (Azure SQL) ou duckdb (Excel local)
FONTE_DADOS=duckdb
VECTOR_STORE_PROVIDER=azure_search
EMBEDDING_MODO=azure_openai

# Azure OpenAI Embeddings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=iakam-rag-index

# Azure SQL Database
AZURE_SQL_SERVER=seu-servidor.database.windows.net
AZURE_SQL_DATABASE=seu-banco
AZURE_SQL_USUARIO=seu-usuario
AZURE_SQL_SENHA=sua-senha
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_SCHEMA=dbo
AZURE_SQL_TABELAS=base_tratada,previsao_kpi
